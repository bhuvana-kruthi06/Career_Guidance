# Local MySQL values for docker-compose.yml. Replace both passwords before use.
MYSQL_ROOT_PASSWORD=replace-with-a-local-root-password
DATABASE_URL=jdbc:mysql://127.0.0.1:3306/ai_career_guidance?useSSL=false&serverTimezone=UTC
DATABASE_USERNAME=career_guidance
DATABASE_PASSWORD=replace-with-a-local-database-password

# Account-backed profiles, assessments, and role recommendations. Replace JWT_SECRET with a private random value (at least 32 bytes).
AUTH_ENABLED=true
JWT_SECRET=replace-with-a-private-random-secret-at-least-32-bytes
AUTH_COOKIE_SECURE=false
VITE_AUTH_ENABLED=true
# Assessment saves can include role recommendation details; default request cap is 2 MB.
ASSESSMENT_MAX_BODY_BYTES=2097152
# Optional initial admin seed. Set all three values before the first backend start.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
# Optional server-only AI integration. Leave blank to use local guidance fallbacks.
CAREER_AI_API_KEY=
CAREER_AI_BASE_URL=https://api.openai.com/v1
CAREER_AI_MODEL=gpt-4o-mini

# Path to locally generated, git-ignored files. Run the README data pipeline first.
PROCESSED_DATA_DIR=./data/processed

# Optional Python CSV loader settings.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ai_career_guidance
DB_USER=career_guidance
DB_PASSWORD=replace-with-a-local-database-password
